{
  "name": "tosijs-3d",
  "version": "0.7.3",
  "description": "Declarative 3D/XR components for the web — Babylon.js and tosijs, composable as custom elements.",
  "license": "Apache-2.0",
  "homepage": "https://3d.tosijs.net",
  "bugs": {
    "url": "https://github.com/tonioloewald/tosijs-3d/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo-utils": {
      "types": "./dist/demo-utils.d.ts",
      "default": "./dist/demo-utils.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "!dist/iife.js",
    "!dist/iife.js.map",
    "!dist/hydrate",
    "CHANGELOG.md",
    "Migration.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tonioloewald/tosijs-3d.git"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.16.2",
    "@babylonjs/gui": "^9.16.2",
    "@babylonjs/loaders": "^9.16.2",
    "@babylonjs/materials": "^9.16.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "babylonjs-gltf2interface": "^9.16.2",
    "chokidar": "^4.0.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "haltija": "^1.12.6",
    "happy-dom": "^20.10.6",
    "jolt-physics": "^1.1.0",
    "prettier": "^2.8.8",
    "tjs-lang": "^0.13.6",
    "tosijs": "^1.8.0",
    "tosijs-ui": "^1.12.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "scripts": {
    "start": "bun format && bun bin/site.ts",
    "build": "bun bin/site.ts --build",
    "tls": "tosijs-dev-certs",
    "icons": "tosijs-make-icons --input ./icons --output ./src/icon-data.ts",
    "tunnel": "tosijs-tunnel",
    "deploy": "tosijs-deploy",
    "format": "bun eslint src bin --fix && bun prettier --write .",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "stop": "bun bin/site.ts --stop"
  },
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/materials": "^9.0.0",
    "jolt-physics": "^1.1.0",
    "tosijs": "^1.7.8"
  },
  "peerDependenciesMeta": {
    "jolt-physics": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
